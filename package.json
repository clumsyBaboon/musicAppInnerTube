{
  "name": "music-app-innertube",
  "productName": "Youtube Music",
  "version": "1.2.0",
  "description": "",
  "homepage": "https://github.com/clumsyBaboon/musicAppInnerTube#readme",
  "bugs": {
    "url": "https://github.com/clumsyBaboon/musicAppInnerTube/issues"
