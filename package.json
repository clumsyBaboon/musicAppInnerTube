  "license": "ISC",
  "author": "clumsyBaboon",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron ."
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "youtubei.js": "^18.0.0"
  },
  "build": {
    "appId": "com.clumsyBaboon.ytmusic",
    "productName": "Youtube Music",
    "directories": {
      "output": "dist"
    },
    "files": [
      "!dist/**/*",
      "!landing/coverflow/**/*",
      "!how_get_cookie.docx"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "landing/img/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "landing/img/icon.icns"
    }
  }
